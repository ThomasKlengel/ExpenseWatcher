<Page x:Class="ExpenseWatcher.Views.ReadCsvPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ExpenseWatcher.Views"
      xmlns:vms="clr-namespace:ExpenseWatcher"
      xmlns:view="clr-namespace:ExpenseWatcher.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NameReplacements">
    <Page.DataContext>
        <view:ReadCsvPageVM/>
    </Page.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <DataTemplate x:Key="HeaderTemplate">
                <StackPanel Orientation="Vertical">
                    <ComboBox SelectedIndex="{Binding SetHeader}">
                        <ComboBoxItem Name="None"                Content="None"                />
                        <ComboBoxItem Name="Date"                Content="Date"                />
                        <ComboBoxItem Name="Time"                Content="Time"                 />
                        <ComboBoxItem Name="Amount"              Content="Amount"               />
                        <ComboBoxItem Name="Currency"            Content="Currency"             />
                        <ComboBoxItem Name="Recipient"           Content="Recipient"            />
                        <ComboBoxItem Name="TransactionID"       Content="TransactionID"            />
                        <ComboBoxItem Name="ReceivedTransaction" Content="ReceivedTransaction"    />
                    </ComboBox>
                    <TextBlock Text="{Binding HeaderFromFile}"/>
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>
        <Button Content="Read CSV" Command="{Binding ReadCsvPartCommand}" Grid.Row="0"/>
        <TextBlock Text="{Binding FirstLines}" Grid.Row="1"/>
        <ListView ItemsSource="{Binding Rows }" Grid.Row="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[0]}"  Header="{Binding Path=Headers[0]}"  HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[1]}"  Header="{Binding Path=Headers[1]}"  HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[2]}"  Header="{Binding Path=Headers[2]}"  HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[3]}"  Header="{Binding Path=Headers[3]}"  HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[4]}"  Header="{Binding Path=Headers[4]}"  HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[5]}"  Header="{Binding Path=Headers[5]}"  HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[6]}"  Header="{Binding Path=Headers[6]}"  HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[7]}"  Header="{Binding Path=Headers[7]}"  HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[8]}"  Header="{Binding Path=Headers[8]}"  HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[9]}"  Header="{Binding Path=Headers[9]}"  HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[10]}" Header="{Binding Path=Headers[10]}" HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[11]}" Header="{Binding Path=Headers[11]}" HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[12]}" Header="{Binding Path=Headers[12]}" HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[13]}" Header="{Binding Path=Headers[13]}" HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[14]}" Header="{Binding Path=Headers[14]}" HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[15]}" Header="{Binding Path=Headers[15]}" HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[16]}" Header="{Binding Path=Headers[16]}" HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[17]}" Header="{Binding Path=Headers[17]}" HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[18]}" Header="{Binding Path=Headers[18]}" HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Path=Items[19]}" Header="{Binding Path=Headers[19]}" HeaderTemplate="{StaticResource HeaderTemplate}" Width="80"/>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Orientation="Horizontal" Grid.Row="3">
            <Button Content="Confirm" Command="{Binding ConfirmCommand}"/>
        </StackPanel>
    </Grid>
</Page>
