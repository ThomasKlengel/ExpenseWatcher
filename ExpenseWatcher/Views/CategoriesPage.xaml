<Page x:Class="ExpenseWatcher.Views.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ExpenseWatcher.Views"
      xmlns:view="clr-namespace:ExpenseWatcher.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CategoriesPage">
    <Page.DataContext>
        <view:CategoriesPageVM/>
    </Page.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <ComboBox ItemsSource="{Binding Categories}" SelectedValue="{Binding SelectedCategory, Mode=TwoWay}"
                  Grid.Row="0" Grid.ColumnSpan="3" Margin="2" >
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Path=Name}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding NewCategory}" Grid.Column="0" Margin="0,0,4,0" Height="28" VerticalContentAlignment="Center"/>

            <ToggleButton Grid.Column="1" Margin="0,0,4,0" MinWidth="100" MinHeight="28"
                          IsChecked="{Binding IsInfoAssignmentMode, Mode=TwoWay}"
                          Content="{Binding AssignmentToggleText}" Foreground="Black"/>

            <Button Command="{Binding AddCategoryCommand}" Grid.Column="2" Margin="0,0,4,0" MinWidth="70" MinHeight="28"
                    Background="#D9E8FF" BorderBrush="#7DA2D9" Foreground="Black" FontWeight="SemiBold">Add</Button>

            <Button Command="{Binding RemoveCategoryCommand}" Grid.Column="3" MinWidth="70" MinHeight="28"
                    Background="#F7D9D9" BorderBrush="#D57A7A" Foreground="Black" FontWeight="SemiBold">Remove</Button>
        </Grid>

        <ListBox ItemsSource="{Binding UnassignedItems}" SelectedValue="{Binding SelectedUnassigned}"
                 Grid.Row="2" Grid.Column="0" Margin="2" />
        <ListBox ItemsSource="{Binding AssignedItems}" SelectedValue="{Binding SelectedAssigned}"
                 Grid.Row="2" Grid.Column="2" Margin="2" />
        <Grid Grid.Column="1" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="1" Margin="5" VerticalAlignment="Bottom" Content="Assign" Command="{Binding AssignItemCommand}"/>
            <Button Grid.Row="2" Margin="5" VerticalAlignment="Top" Content="Unassign" Command="{Binding UnassignItemCommand}"/>
        </Grid>
    </Grid>
</Page>
