<Page x:Class="ExpenseWatcher.Views.ExpenseOverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ExpenseWatcher.Views"
      xmlns:vms="clr-namespace:ExpenseWatcher"
      xmlns:view="clr-namespace:ExpenseWatcher.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NameReplacements">
    <Page.DataContext>
        <view:ExpenseOverviewVM/>
    </Page.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Expander Grid.Row="0" Margin="5" IsExpanded="True" Header="Filter">
            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="8" Background="#FAFAFA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Empfänger" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FilterShop, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Preis" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FilterPriceMin, UpdateSourceTrigger=PropertyChanged}" Width="136" Margin="0,0,0,4" ToolTip="Preis von"/>
                        <TextBox Text="{Binding FilterPriceMax, UpdateSourceTrigger=PropertyChanged}" Width="136" ToolTip="Preis bis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Info" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FilterInfo, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Kategorie" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FilterCategory, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="Zurücksetzen"
                            Command="{Binding ClearFiltersCommand}"
                            VerticalAlignment="Bottom"
                            Padding="10,4"
                            Background="#F0F0F0"/>
                </Grid>
            </Border>
        </Expander>

        <ListView HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding Payments}" Grid.Row="1" Margin="5">
            <ListView.Resources>
                <!--create style to sort rows on column header click-->
                <!--(columnheaders a buttons by default)-->
                <Style TargetType="{x:Type GridViewColumnHeader}">
                    <Setter Property="Command" Value="{Binding SortCommand}"/>
                    <Setter Property="CommandParameter" Value="{Binding RelativeSource = {RelativeSource Self}}"/>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding Shop}" Header="Empfänger" Width="200"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Price, ConverterCulture='de-DE' , StringFormat= {}{0:C}}" Header="Preis" Width="Auto"/>
                    <GridViewColumn DisplayMemberBinding="{Binding DateOfPayment, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Header="Datum" Width="Auto"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Info}" Header="Info" Width="Auto"/>
                    <GridViewColumn DisplayMemberBinding="{Binding CategoryName}" Header="Kategorie" Width="150"/>
                    <GridViewColumn DisplayMemberBinding="{Binding TransactionCode}" Header="Transaktion" Width="Auto"/>
                    <GridViewColumn DisplayMemberBinding="{Binding AuthorizationCode}" Header="Genehmigung" Width="Auto"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
